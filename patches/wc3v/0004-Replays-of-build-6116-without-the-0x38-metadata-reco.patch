From 37d79a4b814d9cba3fd7a7671ac44b066201bd96 Mon Sep 17 00:00:00 2001
From: bubunuh <76405364+bubunuh@users.noreply.github.com>
Date: Fri, 13 Nov 2026 23:52:00 +0100
Subject: [PATCH 4/8] Replays of build 6116+ without the 0x38 metadata record
 are read with the newer action layout

The game's own copy of a W3Champions game, and games against the computer or in custom
lobbies, carry no 0x38 record, so w3gjs read their game data with the pre-2.0.2 action ids:
each 0x7a (16 bytes) was skipped as 20, breaking the rest of its command block and with it
nearly every train and research order (an 18-worker Human tracked as 5-9 workers). Of 3,762
replays checked, 43 of builds 7000-7003 have no record: 42 were misread, none is now, and no
other replay reads differently.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 wc3v.js | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/wc3v.js b/wc3v.js
index ba2abae..688c0f4 100644
--- a/wc3v.js
+++ b/wc3v.js
@@ -134,6 +134,23 @@ const doParsing = async (input, options = {}) => {
   const buffer = Buffer.isBuffer(input) ? input : fs.readFileSync(input);
   const parser = new ReplayParser();
 
+  // Since game build 6116 (patch 2.0.2) the game data uses the newer action
+  // layout (ids above 0x77 moved up by one), but w3gjs only reads it that way
+  // when the player metadata has a 0x38 record. The game's own copy of a
+  // W3Champions game, and games against the computer or in custom lobbies,
+  // have none: read the old way, each 0x7a (16 bytes) is skipped as 20, which
+  // breaks the rest of its command block and nearly every train and research
+  // order with it. Build 6115 has both layouts; its record says which.
+  {
+    let buildNo = 0;
+    parser.on("basic_replay_information", (info) => {
+      buildNo = (info && info.subheader && info.subheader.buildNo) || 0;
+    });
+    const gdp = parser.gameDataParser;
+    const parseGameData = gdp.parse.bind(gdp);
+    gdp.parse = (data, isPost202) => parseGameData(data, isPost202 || buildNo >= 6116);
+  }
+
   let replayMeta = null;
   let durationMs = 0;
 
