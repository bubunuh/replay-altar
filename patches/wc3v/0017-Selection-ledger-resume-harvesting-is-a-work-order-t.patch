From 3d5c943ff931a649c5c353c74e54f0639b0cf2d9 Mon Sep 17 00:00:00 2001
From: bubunuh <76405364+bubunuh@users.noreply.github.com>
Date: Sun, 25 Oct 2026 01:34:18 +0200
Subject: [PATCH 17/21] Selection ledger: resume-harvesting is a work order too

Ghouls sent back to the trees with Resume Harvesting (0xD0031) were not seen
as working, and fell to the one-minute silence rule for listed units.

Dev games: Undead army value error 80 -> 70, all 80 -> 78.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/PlayerManager.js | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/lib/PlayerManager.js b/lib/PlayerManager.js
index 176633c..e2127e8 100644
--- a/lib/PlayerManager.js
+++ b/lib/PlayerManager.js
@@ -55,6 +55,7 @@ const WPMFile = require("./parsers/WPMFile"),
 const ORDER_SMART = 0xD0003;
 const ORDER_ATTACK = 0xD000F;
 const ORDER_HARVEST = 0xD0032;
+const ORDER_RESUME_HARVESTING = 0xD0031;
 // A click on a tree targets the tree's own spot.
 const TREE_CLICK_RADIUS = 16;
 
@@ -533,10 +534,11 @@ const PlayerManager = class {
         if (ABILITY_ACTION_NAMES.has(actionName)) {
           const twoTargets = actionName === 'UnitBuildingAbilityActionTwoTargetPositions';
           const orderId = this._orderIdNumber(twoTargets ? action.itemId1 : action.itemId);
-          // a harvest order, or a right-click on a tree: the units go to work.
+          // a harvest or resume-harvesting order, or a right-click on a tree:
+          // the units go to work.
           // The tree comes as the second id of a two-target order (tree
           // destructables are all "?T??"), or as an object at a tree's spot.
-          const work = orderId === ORDER_HARVEST ||
+          const work = orderId === ORDER_HARVEST || orderId === ORDER_RESUME_HARVESTING ||
             (orderId === ORDER_SMART && (twoTargets
               ? this._isTreeId(action.itemId2)
               : this._isTreeTarget(action)));
