From e9487cd46e16bd469dfa78d4987821a498ce7c0e Mon Sep 17 00:00:00 2001
From: bubunuh <76405364+bubunuh@users.noreply.github.com>
Date: Sun, 25 Oct 2026 01:14:08 +0200
Subject: [PATCH 14/21] DeathInference: a listed unit's activity is its
 listings, not its path

WC3V keeps ordering units that died in its stale copies of hotkey groups, so
their paths go on long after the game stopped naming them in any list, and
path silence never caught them. For a (non-worker) unit the selection lists
track, its last listing is now its last activity, and a minute without one
(players list their army many times a minute) makes it possiblyLost from
there; untracked units keep the two-minute path rule.

Dev games: army value error 86 -> 80 (Orc 62 -> 54, Night Elf 109 -> 101).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/DeathInference.js | 18 +++++++++++++-----
 1 file changed, 13 insertions(+), 5 deletions(-)

diff --git a/lib/DeathInference.js b/lib/DeathInference.js
index adbc0a0..303dcec 100644
--- a/lib/DeathInference.js
+++ b/lib/DeathInference.js
@@ -33,6 +33,9 @@
 const IDLE_MS = 30 * 1000;          // path silent this long → idle
 const POSSIBLY_LOST_MS = 60 * 1000; // silent + battle context → possiblyLost
 const LOST_MS = 120 * 1000;         // silent this long → lost (last resort)
+// A unit the selection lists track and that they haven't named for this long:
+// players list their army many times a minute, so it is gone.
+const LISTED_LOST_MS = 60 * 1000;
 
 // Rough XP table (WC3 doesn't give big XP for non-creep PvP kills).
 function estimateXpReward (unit) {
@@ -172,10 +175,15 @@ class DeathInference {
     // selected and clicked on (by raiders) right up to the harass that kills
     // them, so for them the lists say too little either way.
     const listedLast = life && !isWorker ? life.last : -Infinity;
-    const lastActivity = Math.max(
-      lastSample ? lastSample.gameTime : (unit.spawnTime || 0),
-      listedLast
-    );
+    //
+    // For a unit the lists track, they are its activity, not its path: WC3V
+    // keeps ordering units that died in its stale copies of hotkey groups, so
+    // their paths go on long after the lists stopped naming them.
+    const pathLast = lastSample ? lastSample.gameTime : (unit.spawnTime || 0);
+    const tracked = !!(life && !isWorker);
+    const lastActivity = tracked
+      ? Math.max(listedLast, unit.spawnTime || 0)
+      : Math.max(pathLast, listedLast);
     const gameEnd = this._gameEndTime();
     const silentFor = gameEnd - lastActivity;
 
@@ -252,7 +260,7 @@ class DeathInference {
     }
 
     // 4. No battle context — pure path-silence heuristic.
-    if (silentFor >= LOST_MS) {
+    if (silentFor >= (tracked ? LISTED_LOST_MS : LOST_MS)) {
       return {
         state: 'possiblyLost',  // never "lost" without a battle anchor
         since: lastActivity,
