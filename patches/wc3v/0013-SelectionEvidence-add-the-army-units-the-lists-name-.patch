From ebefc8d372316d640c3cbf211389204024fa1436 Mon Sep 17 00:00:00 2001
From: bubunuh <76405364+bubunuh@users.noreply.github.com>
Date: Sun, 25 Oct 2026 01:07:06 +0200
Subject: [PATCH 13/21] SelectionEvidence: add the army units the lists name
 that WC3V never made

A handle that SelectSubgroup names as an army unit type, that the player
ordered, grouped or box-selected, and that no simulated unit took, is a unit
WC3V never saw made: a hired mercenary (WC3V only catches the hire when the
camp was selected just before), a Hippogryph Rider (an Archer and a
Hippogryph merge into a new unit), a unit whose training it missed. Add it to
the player's units from the latest time it can have been made, with the
selection evidence for its life and the forms SelectSubgroup saw it in. It
has no path of its own (one sample at the start position); the export marks
it fromSelectionLists. Handles made at the start are left alone: the map's
own units, or start units WC3V has.

Dev games: army value error 89 -> 86, unit-type count error 0.83 -> 0.78.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/SelectionEvidence.js | 65 +++++++++++++++++++++++++++++++++-------
 lib/Unit.js              |  3 ++
 2 files changed, 58 insertions(+), 10 deletions(-)

diff --git a/lib/SelectionEvidence.js b/lib/SelectionEvidence.js
index a0bbbe2..faea9d9 100644
--- a/lib/SelectionEvidence.js
+++ b/lib/SelectionEvidence.js
@@ -12,18 +12,25 @@
  *   unit.selectionLife = { handle, first, last, lastKind, death, lastOrder }
  *
  * which DeathInference reads: a death the lists show ends the unit there, and
- * a later sighting keeps it alive past what its path alone would say.
+ * a later sighting keeps it alive past what its path alone would say. A unit
+ * the lists never show is flagged selectionUnlisted. A handle the lists name
+ * as an army unit that no simulated unit took becomes a new unit
+ * (fromSelectionLists): hired mercenaries, Hippogryph Riders, units whose
+ * training WC3V missed.
  */
 
 const HandleBinder = require('./HandleBinder');
+const Unit = require('./Unit');
 const { getUnitInfo, getBuildTime } = require('../helpers/mappings');
 
+const START_MS = 1000;
+
 const isPlayerId = (id) => Number(id) >= 0 && Number(id) < 24;
 
 class SelectionEvidence {
   constructor (playerManager) {
     this.playerManager = playerManager;
-    this.stats = { handles: 0, units: 0, tied: 0, kept: 0, retied: 0, deaths: 0 };
+    this.stats = { handles: 0, units: 0, tied: 0, kept: 0, retied: 0, deaths: 0, added: 0 };
   }
 
   run () {
@@ -161,14 +168,52 @@ class SelectionEvidence {
       if (key === e.handle) this.stats.kept++;
       else this.stats.retied++;
       if (h.death) this.stats.deaths++;
-      e.unit.selectionLife = {
-        handle: key,
-        first: h.first,
-        last: h.last,
-        lastKind: h.lastKind,
-        death: h.death,
-        lastOrder: h.lastOrder
-      };
+      e.unit.selectionLife = this._life(key, h);
+    }
+
+    this._addListedUnits(player, handles, new Set(ties.values()));
+  }
+
+  _life (key, h) {
+    return {
+      handle: key,
+      first: h.first,
+      last: h.last,
+      lastKind: h.lastKind,
+      death: h.death,
+      lastOrder: h.lastOrder
+    };
+  }
+
+  // A handle the lists name as an army unit type that no simulated unit took:
+  // a unit WC3V never saw made — a hired mercenary, a Hippogryph Rider (an
+  // archer and a hippogryph merged into a new unit). Add it, from the latest
+  // time it can have been made.
+  _addListedUnits (player, handles, tied) {
+    for (const [key, h] of handles) {
+      if (tied.has(key) || !h.types.length) continue;
+      const type = h.types[0].type;
+      const info = getUnitInfo(type);
+      const food = (info.balanceInfo && info.balanceInfo.foodUsed) || 0;
+      if (!info.isUnit || info.isBuilding || !food) continue;
+      if (info.meta && (info.meta.hero || info.meta.worker)) continue;
+
+      const born = Math.min(h.first, this.madeBy(h.counter));
+      // made at the start: the map's own units (creeps), or start units WC3V has
+      if (born < START_MS) continue;
+      const unit = new Unit(player.eventTimer, h.key.split('/')[0], h.key.split('/')[1], type, false);
+      unit.spawnTime = born;
+      unit.trainedTime = born;
+      unit.fromSelectionLists = true;
+      const at = player.startingPosition || { x: 0, y: 0 };
+      unit.currentX = at.x;
+      unit.currentY = at.y;
+      unit.spawnPosition = { x: at.x, y: at.y };
+      unit.path = [{ x: at.x, y: at.y, gameTime: born, facing: 0 }];
+      for (const t of h.types.slice(1)) unit.morphTo(t.type, t.t);
+      unit.selectionLife = this._life(key, h);
+      player.units.push(unit);
+      this.stats.added++;
     }
   }
 }
diff --git a/lib/Unit.js b/lib/Unit.js
index 7f7b776..072bcc7 100644
--- a/lib/Unit.js
+++ b/lib/Unit.js
@@ -1300,6 +1300,9 @@ const Unit = class {
       // default). The 3D viewer hides workers it isn't confident are harvesting
       // (e.g. a freshly-trained ghoul left idle on rally next to its building).
       ...(self.harvestConfident ? { harvestConfident: true } : {}),
+      // Added after the simulation from the replay's selection lists (a unit
+      // the lists name that WC3V never saw made): no path of its own.
+      ...(self.fromSelectionLists ? { fromSelectionLists: true } : {}),
       // Time windows (gameTime ms) when this worker is a VISIBLE builder
       // (walking to / summoning / constructing). The viewer un-hides it then.
       ...(self.buildWindows && self.buildWindows.length ? { buildWindows: self.buildWindows } : {}),
-- 
