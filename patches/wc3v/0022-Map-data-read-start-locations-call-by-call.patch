From 772fc4800b62b7a2934fcede22b763b0b1ba6688 Mon Sep 17 00:00:00 2001
From: bubunuh <76405364+bubunuh@users.noreply.github.com>
Date: Tue, 27 Oct 2026 08:48:16 +0100
Subject: [PATCH 22/23] Map data: read start locations call by call

LUAJASSFile took every script line containing DefineStartLocation and
read it with a greedy "(...)". Minified Lua maps (the copies hosted under
hashed names in Maps/dz/) put the whole script on one line, so the match
ran from the first parenthesis of the file to the last and the map got
one start location named "_ENV" (or a fragment of code) at (null, null).
Optimised JASS (several ATR maps) writes "- 1280.0", which parseFloat
read as NaN. Every replay on those maps stopped at the first move order,
where the player's start position is placed (Unit.recordPosition:
"Cannot read properties of null (reading 'toFixed')").

Each DefineStartLocation(spot, x, y) call is now matched on its own, with
the sign's space allowed. Over the 318 extracted maps it reads 60 that were
broken (55 hashed Lua maps, 5 ATR maps) and gives the same positions for
the other 258. Map entries generated before this need tools/data-tool.js
re-run (--force) for those maps.

tests/start-locations.test.js covers JASS, Lua, minified Lua and the
optimised JASS sign on hand-written scripts.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/parsers/LUAJASSFile.js    | 57 +++++++++++----------
 tests/start-locations.test.js | 95 +++++++++++++++++++++++++++++++++++
 2 files changed, 125 insertions(+), 27 deletions(-)
 create mode 100644 tests/start-locations.test.js

diff --git a/lib/parsers/LUAJASSFile.js b/lib/parsers/LUAJASSFile.js
index c8f86fe..c6f2a2d 100644
--- a/lib/parsers/LUAJASSFile.js
+++ b/lib/parsers/LUAJASSFile.js
@@ -11,37 +11,40 @@ const LUAJASSFile = class {
 
   read (filePath, mapData) {
     const buffer = fs.readFileSync(filePath, 'utf-8');
-    const lines = buffer.split(/\r?\n/);
 
-    const searchTarget = 'DefineStartLocation';
-    const targets = [];
-
-    lines.forEach((rawLine, lineIndex) => {
-      const line = rawLine.trim();
+    this.startingPositions = LUAJASSFile.findStartLocations(buffer);
+  }
 
-      if (line.indexOf(searchTarget) != -1) {
-        targets.push(line);
-      }
-    });
+  // Every DefineStartLocation(spot, x, y) call in a war3map.j or war3map.lua,
+  // keyed by spot id.
+  //
+  // Matched call by call, not line by line: minified Lua maps (the copies
+  // hosted under hashed names in Maps/dz/) put the whole script on one line,
+  // and a greedy "(...)" over that line read from the first parenthesis of
+  // the file to the last, giving one spot named "_ENV" at (null, null).
+  // Optimised JASS (several ATR maps) writes a space after the sign,
+  // "- 1280.0", which parseFloat read as NaN. Every game on those maps then
+  // stopped at its first move order, where the start position is placed.
+  static findStartLocations (script) {
+    // optimised JASS writes a space after the sign: "- 1280.0"
+    const number = '([-+]?\\s*(?:\\d+(?:\\.\\d*)?|\\.\\d+))';
+    const pattern = new RegExp(
+      `DefineStartLocation\\s*\\(\\s*(\\d+)\\s*,\\s*${number}\\s*,\\s*${number}\\s*\\)`, 'g');
 
     const output = {};
-    const pattern = new RegExp(/\((.*)\)/, 'g');
-    
-    targets.forEach(target => {
-      const matches = target.match(pattern);
-      const trimmed = matches.map(match => {
-        return match.substring(1, match.length - 1);
-      });
-
-      trimmed.forEach(item => {
-        const arr = item.split(",");
-
-        // add the starting position to the output object with the key as the spot id
-        output[arr[0]] = { x: parseFloat(arr[1]), y: parseFloat(arr[2]) };
-      });
-    });
-
-    this.startingPositions = output;
+    let match;
+
+    while ((match = pattern.exec(script)) !== null) {
+      const [ , spotId, x, y ] = match;
+
+      // add the starting position to the output object with the key as the spot id
+      output[spotId] = {
+        x: parseFloat(x.replace(/\s+/g, '')),
+        y: parseFloat(y.replace(/\s+/g, ''))
+      };
+    }
+
+    return output;
   }
 };
 
diff --git a/tests/start-locations.test.js b/tests/start-locations.test.js
new file mode 100644
index 0000000..e076621
--- /dev/null
+++ b/tests/start-locations.test.js
@@ -0,0 +1,95 @@
+/*
+ * start-locations.test.js — pure unit tests for reading a map script's
+ * start locations (LUAJASSFile.findStartLocations).
+ *
+ * Covers:
+ *   1. World Editor JASS, one call per line
+ *   2. Lua, one call per line
+ *   3. Minified Lua: the whole script on one line, among other calls
+ *   4. Optimised JASS: a space between the sign and the number
+ *
+ * Run: `node tests/start-locations.test.js`
+ */
+
+const assert = require('assert');
+const LUAJASSFile = require('../lib/parsers/LUAJASSFile');
+
+const { findStartLocations } = LUAJASSFile;
+
+let failures = 0;
+function check (label, fn) {
+  try {
+    fn();
+    console.log(`  ✓ ${label}`);
+  } catch (err) {
+    failures++;
+    console.log(`  ✗ ${label}`);
+    console.log(`    ${err.message}`);
+  }
+}
+
+console.log('[findStartLocations]');
+
+check('World Editor JASS', () => {
+  const script = [
+    'function config takes nothing returns nothing',
+    '    call SetPlayers( 2 )',
+    '    call DefineStartLocation( 0, -2176.0, -4672.0 )',
+    '    call DefineStartLocation( 1, 2176.0, 4672.0 )',
+    'endfunction'
+  ].join('\r\n');
+
+  assert.deepStrictEqual(findStartLocations(script), {
+    0: { x: -2176, y: -4672 },
+    1: { x: 2176, y: 4672 }
+  });
+});
+
+check('Lua', () => {
+  const script = [
+    'function config()',
+    '    SetPlayers(2)',
+    '    DefineStartLocation(0, -3840.0, -3968.0)',
+    '    DefineStartLocation(1, 3840.0, 3264.0)',
+    'end'
+  ].join('\n');
+
+  assert.deepStrictEqual(findStartLocations(script), {
+    0: { x: -3840, y: -3968 },
+    1: { x: 3840, y: 3264 }
+  });
+});
+
+check('minified Lua: one line, other calls around the start locations', () => {
+  const script = "a['x.lua']=function(_ENV,...)local M={}M.f=function(N,O)BlzFrameSetVisible(N,O)end;" +
+    'function config()SetMapName("TRIGSTR_001")SetPlayers(2)SetTeams(2)' +
+    'DefineStartLocation(0,-3904.0,3328.0)DefineStartLocation(1,3904.0,-3840.0)' +
+    'InitCustomPlayerSlots()end;return M end';
+
+  assert.deepStrictEqual(findStartLocations(script), {
+    0: { x: -3904, y: 3328 },
+    1: { x: 3904, y: -3840 }
+  });
+});
+
+check('optimised JASS: a space after the sign', () => {
+  const script = 'call DefineStartLocation(0, - 1280.0, 256.0)\n' +
+    'call DefineStartLocation(1, 5376.0, - 8448.0)\n';
+
+  assert.deepStrictEqual(findStartLocations(script), {
+    0: { x: -1280, y: 256 },
+    1: { x: 5376, y: -8448 }
+  });
+});
+
+check('no start locations', () => {
+  assert.deepStrictEqual(findStartLocations('function main()\nend'), {});
+});
+
+console.log('');
+if (failures) {
+  console.log(`FAILED — ${failures} check(s)`);
+  process.exit(1);
+} else {
+  console.log('OK — all checks passed');
+}
