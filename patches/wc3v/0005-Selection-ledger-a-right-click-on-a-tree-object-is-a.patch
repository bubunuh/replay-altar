From 293b22f1f44a9f8cdec4891684a015e916e73a5d Mon Sep 17 00:00:00 2001
From: bubunuh <76405364+bubunuh@users.noreply.github.com>
Date: Sun, 25 Oct 2026 00:17:24 +0200
Subject: [PATCH 05/21] Selection ledger: a right-click on a tree object is a
 work order too

A right-click on a tree reaches the replay in two shapes: a two-target order
whose second id is the tree type, or an order on the tree's object handle at the
tree's own spot. The second shape was not recognised as a harvest order, so
ghouls sent to the trees that way were still lost to path silence. Use the
world's tree index (findTreeNear, already used by PlayerActions for the same
click) to recognise it.

Dev games: Undead army value error 176 -> 169, all 122 -> 120.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/PlayerManager.js | 18 ++++++++++++++----
 1 file changed, 14 insertions(+), 4 deletions(-)

diff --git a/lib/PlayerManager.js b/lib/PlayerManager.js
index 1861462..ce484f4 100644
--- a/lib/PlayerManager.js
+++ b/lib/PlayerManager.js
@@ -55,6 +55,8 @@ const WPMFile = require("./parsers/WPMFile"),
 const ORDER_SMART = 0xD0003;
 const ORDER_ATTACK = 0xD000F;
 const ORDER_HARVEST = 0xD0032;
+// A click on a tree targets the tree's own spot.
+const TREE_CLICK_RADIUS = 16;
 
 const ABILITY_DEDUP_WINDOW_MS = 250;
 // 50 game units ≈ 1.5 tiles. Targets within this radius of a same-signature
@@ -531,11 +533,13 @@ const PlayerManager = class {
         if (ABILITY_ACTION_NAMES.has(actionName)) {
           const twoTargets = actionName === 'UnitBuildingAbilityActionTwoTargetPositions';
           const orderId = this._orderIdNumber(twoTargets ? action.itemId1 : action.itemId);
-          // a right-click on a tree (the second id of a two-target order is
-          // what was clicked; tree destructables are all "?T??") or a harvest
-          // order: the units go to work
+          // a harvest order, or a right-click on a tree: the units go to work.
+          // The tree comes as the second id of a two-target order (tree
+          // destructables are all "?T??"), or as an object at a tree's spot.
           const work = orderId === ORDER_HARVEST ||
-            (twoTargets && orderId === ORDER_SMART && this._isTreeId(action.itemId2));
+            (orderId === ORDER_SMART && (twoTargets
+              ? this._isTreeId(action.itemId2)
+              : this._isTreeTarget(action)));
           ledger.order(playerId, gameTime, orderId, action.objectId1, action.objectId2,
             orderId === ORDER_SMART || orderId === ORDER_ATTACK, work);
         }
@@ -552,6 +556,12 @@ const PlayerManager = class {
     return itemId;
   }
 
+  _isTreeTarget (action) {
+    if (!SelectionLedger.isRealHandle(action.objectId1, action.objectId2)) return false;
+    if (action.targetX == null || !this.world || !this.world.findTreeNear) return false;
+    return !!this.world.findTreeNear(action.targetX, action.targetY, TREE_CLICK_RADIUS);
+  }
+
   _isTreeId (itemId) {
     if (!Array.isArray(itemId) || itemId.length !== 4) return false;
     return String.fromCharCode(itemId[2]) === 'T';     // little-endian: "WTtw" is [w, t, T, W]
