From 2f508b8ddce4da386a58ad27cd0e43690647e5d8 Mon Sep 17 00:00:00 2001
From: bubunuh <76405364+bubunuh@users.noreply.github.com>
Date: Sun, 25 Oct 2026 01:42:04 +0200
Subject: [PATCH 19/21] SelectionEvidence: give tied units the forms the lists
 saw them in

SelectSubgroup names the current form of the unit it reports: a Druid of the
Claw in Bear Form, a Destroyer, a Hippogryph that picked up an Archer (now a
Rider), a burrowed Crypt Fiend. For a tied unit the simulation never morphed
itself, morph it at each change of form the lists show (peasants excepted:
the simulation models militia itself). The Hippogryph and its Rider become
one form class for the binder.

Army value is unaffected for same-cost forms; dev unit-type count error
0.73 -> 0.69, army 76.3 -> 76.4.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/HandleBinder.js      |  7 +++++--
 lib/SelectionEvidence.js | 14 ++++++++++++++
 2 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/lib/HandleBinder.js b/lib/HandleBinder.js
index 72dede6..2044519 100644
--- a/lib/HandleBinder.js
+++ b/lib/HandleBinder.js
@@ -17,10 +17,13 @@
 
 // Forms of one unit that keep its handle: toggled forms (Bear / Crow Form,
 // Burrow, Ethereal Form, Stone Form, Metamorphosis), Destroyer Form, militia,
-// and the units a research turns into another type (Berserker upgrade, Barrage).
+// the units a research turns into another type (Berserker upgrade, Barrage),
+// and the Hippogryph that picks up an Archer (it becomes the Rider; the Archer
+// is gone).
 const FORM_CLASSES = [
   ['edoc', 'edcm'], ['edot', 'edtm'], ['ucry', 'ucrm'], ['ospw', 'ospm'], ['uobs', 'ubsp'],
-  ['hpea', 'hmil'], ['ugar', 'ugrm'], ['Edem', 'Edmm'], ['ohun', 'otbk'], ['hmtt', 'hrtt']
+  ['hpea', 'hmil'], ['ugar', 'ugrm'], ['Edem', 'Edmm'], ['ohun', 'otbk'], ['hmtt', 'hrtt'],
+  ['ehip', 'ehpr']
 ];
 const formClassOf = new Map();
 for (const cls of FORM_CLASSES) for (const id of cls) formClassOf.set(id, cls[0]);
diff --git a/lib/SelectionEvidence.js b/lib/SelectionEvidence.js
index faea9d9..10543e1 100644
--- a/lib/SelectionEvidence.js
+++ b/lib/SelectionEvidence.js
@@ -169,11 +169,25 @@ class SelectionEvidence {
       else this.stats.retied++;
       if (h.death) this.stats.deaths++;
       e.unit.selectionLife = this._life(key, h);
+      this._applyListedForms(e.unit, h);
     }
 
     this._addListedUnits(player, handles, new Set(ties.values()));
   }
 
+  // The forms SelectSubgroup saw the unit in (Bear Form, Destroyer, Rider...),
+  // for a unit the simulation never morphed itself.
+  _applyListedForms (unit, h) {
+    // (not peasants: militia comes and goes on its own timer, which the
+    // simulation already models)
+    if ((unit.morphHistory || []).length || HandleBinder.formClass(unit.itemId) === 'hpea') return;
+    for (const { t, type } of h.types) {
+      if (type === unit.itemId) continue;
+      if (HandleBinder.formClass(type) !== HandleBinder.formClass(unit.itemId)) continue;
+      unit.morphTo(type, t);
+    }
+  }
+
   _life (key, h) {
     return {
       handle: key,
-- 
