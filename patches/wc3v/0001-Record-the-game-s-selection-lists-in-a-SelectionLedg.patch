+  // Before dispatch: the handlers rewrite some of these lists in place.
+  _recordSelectionEvidence (player, actionName, action, gameTime) {
+    const ledger = this.selectionLedger;
+    if (!ledger || !player || player.isNeutralPlayer) return;
+    const playerId = player.id;
+
+    switch (actionName) {
+      case "ChangeSelectionAction":
+        ledger.selectionChange(playerId, gameTime, action.selectMode, action.actions);
+      break;
+      case "PreSubselection":
+        ledger.preSubselection(playerId, gameTime, action.objectId1, action.objectId2);
+      break;
+      case "AssignGroupHotkeyAction":
+        ledger.assignGroup(playerId, gameTime, action.groupNumber, action.actions);
+      break;
+      case "SelectGroupHotkeyAction":
+        ledger.selectGroup(playerId, gameTime, action.groupNumber);
+      break;
+      case "SelectSubgroupAction":
+        if (typeof action.itemId === "string") {
+          ledger.selectSubgroup(playerId, gameTime, action.itemId, action.objectId1, action.objectId2);
+        }
+      break;
+      default:
+        if (ABILITY_ACTION_NAMES.has(actionName)) {
+          const twoTargets = actionName === 'UnitBuildingAbilityActionTwoTargetPositions';
+          const orderId = this._orderIdNumber(twoTargets ? action.itemId1 : action.itemId);
+          // a right-click on a tree (the second id of a two-target order is
+          // what was clicked; tree destructables are all "?T??") or a harvest
+          // order: the units go to work
+          const work = orderId === ORDER_HARVEST ||
+            (twoTargets && orderId === ORDER_SMART && this._isTreeId(action.itemId2));
+          ledger.order(playerId, gameTime, orderId, action.objectId1, action.objectId2,
+            orderId === ORDER_SMART || orderId === ORDER_ATTACK, work);
+        }
+      break;
+    }
+  }
+
+  // An order id as one number: still a byte array for orders (only object ids
+  // with letters are turned into strings by fixBrokenActionFormat).
+  _orderIdNumber (itemId) {
+    if (Array.isArray(itemId)) {
+      return ((itemId[0] | (itemId[1] << 8) | (itemId[2] << 16) | (itemId[3] << 24)) >>> 0);
+    }
+    return itemId;
+  }
+
+  _isTreeId (itemId) {
+    if (!Array.isArray(itemId) || itemId.length !== 4) return false;
+    return String.fromCharCode(itemId[2]) === 'T';     // little-endian: "WTtw" is [w, t, T, W]
+  }
