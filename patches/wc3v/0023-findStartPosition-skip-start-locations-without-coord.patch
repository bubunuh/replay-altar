From 11953057394febd947dc4206f5e1a683cf5970b0 Mon Sep 17 00:00:00 2001
From: bubunuh <76405364+bubunuh@users.noreply.github.com>
Date: Tue, 27 Oct 2026 08:48:50 +0100
Subject: [PATCH 23/23] findStartPosition: skip start locations without
 coordinates

A map entry made by tools/data-tool.js before the previous commit can
hold start locations at (null, null). The nearest-spot search then picked
one and the parse died placing the town hall, with a TypeError from
Unit.recordPosition that says nothing about the map. Spots without finite
coordinates are now left out; when none is left the error names the map
and says to regenerate its entry, like the "unrecognized map" error does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/PlayerActions.js | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/lib/PlayerActions.js b/lib/PlayerActions.js
index 14caf2e..31ab5e7 100644
--- a/lib/PlayerActions.js
+++ b/lib/PlayerActions.js
@@ -576,7 +576,21 @@ const PlayerActions = class {
       throw Error("unrecognized map");
     }
 
-    let positions = Object.keys(startPositions).map(spotId => {
+    // A map entry generated by an older tools/data-tool.js can carry start
+    // locations without coordinates (it misread minified Lua and optimised
+    // JASS scripts). Placing the base there threw a TypeError deep in
+    // Unit.recordPosition; skip such spots and, if none is left, say why.
+    const usableSpots = Object.keys(startPositions).filter(spotId => {
+      const { x, y } = startPositions[spotId] || {};
+      return Number.isFinite(x) && Number.isFinite(y);
+    });
+
+    if (!usableSpots.length) {
+      console.error("map has no usable start positions: regenerate its entry with tools/data-tool.js", baseMapName);
+      throw Error(`map has no usable start positions: ${baseMapName}`);
+    }
+
+    let positions = usableSpots.map(spotId => {
       const startPosition = startPositions[spotId];
       const { x, y } = startPosition;
 
