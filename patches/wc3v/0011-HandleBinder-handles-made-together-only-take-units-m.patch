From 347b708612521c95852225839c437c93f36e847b Mon Sep 17 00:00:00 2001
From: bubunuh <76405364+bubunuh@users.noreply.github.com>
Date: Sun, 25 Oct 2026 01:00:49 +0200
Subject: [PATCH 11/21] HandleBinder: handles made together only take units
 made together

Units the game makes in one go (summons, a train order finishing in several
buildings at once) get handles a handful of allocations apart (about 17 for a
skeleton, 23 for a peasant, 28 for a druid); units made at separate moments
are hundreds apart. WC3V never sees most autocast summons (Raise Dead,
Carrion Beetles), and the alignment tied trained ghouls and crypt fiends to
those summons' handles, so they died when the summons expired. Such a handle
now only takes a unit WC3V also made together with another (within 1.5 s).

Dev games: army value error 102 -> 93 (Undead 138 -> 104), type count
error 0.93 -> 0.87.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/HandleBinder.js         | 20 ++++++++++++++++++++
 tests/handle-binder.test.js | 10 ++++++++++
 2 files changed, 30 insertions(+)

diff --git a/lib/HandleBinder.js b/lib/HandleBinder.js
index abb719e..0e62c4c 100644
--- a/lib/HandleBinder.js
+++ b/lib/HandleBinder.js
@@ -38,6 +38,11 @@ const TYPED_BONUS = 0.5;
 // The tie the simulation made itself: a hint, not a given. Kept outright, the
 // ties it got out of creation order block the alignment of everything else.
 const SIMULATION_TIE_BONUS = 0.2;
+// Units the game makes in one go are a handful of counters apart (the
+// allocations of one unit: ~17 for a skeleton, ~23 for a peasant, ~28 for a
+// druid); units made at separate moments are hundreds apart.
+const TWIN_COUNTER_GAP = 30;
+const TWIN_BORN_MS = 1500;
 
 class HandleBinder {
   // units:   [{ id, forms: Set, earliest, born, handle }] — a unit came out in
@@ -58,8 +63,23 @@ class HandleBinder {
     const n = us.length, m = hs.length;
     if (!n || !m) return result;
 
+    // Handles the game made together (counters a few apart): one event made
+    // several units — summons, or one train order finishing in several
+    // buildings at once. Such a handle only takes a unit WC3V also made
+    // together with another; else trained units get tied to the skeletons and
+    // beetles WC3V never saw summoned, and die with them.
+    const twinHandle = new Set();
+    for (let j = 1; j < hs.length; j++) {
+      if (hs[j].counter - hs[j - 1].counter <= TWIN_COUNTER_GAP) { twinHandle.add(hs[j].key); twinHandle.add(hs[j - 1].key); }
+    }
+    const twinUnit = new Set();
+    for (let i = 1; i < us.length; i++) {
+      if (us[i].born - us[i - 1].born <= TWIN_BORN_MS) { twinUnit.add(us[i].id); twinUnit.add(us[i - 1].id); }
+    }
+
     const gain = (u, h) => {
       const simulated = u.handle === h.key;
+      if (!simulated && twinHandle.has(h.key) && !twinUnit.has(u.id)) return null;
       const latest = Math.min(h.first, madeBy ? madeBy(h.counter) : Infinity);
       if (!simulated && u.earliest > latest + LISTED_BEFORE_TRAINED_SLACK_MS) return null;
       let g = 1 + (simulated ? SIMULATION_TIE_BONUS : 0);
diff --git a/tests/handle-binder.test.js b/tests/handle-binder.test.js
index 7f70f3f..cecfb98 100644
--- a/tests/handle-binder.test.js
+++ b/tests/handle-binder.test.js
@@ -108,6 +108,16 @@ check('with anchors, the creation time the counter implies picks among handles',
   assert.strictEqual(ties.get(1), '2/2000');
 });
 
+check('handles made together only take units made together', () => {
+  // two summons WC3V never saw, then a trained unit's handle
+  const hs = handles(handle('1/1000', 30000), handle('2/1017', 30000), handle('3/1400', 31000));
+  const ties = HandleBinder.bind([unit(1, 'ugho', 25000)], hs);
+  assert.strictEqual(ties.get(1), '3/1400');
+  const twins = HandleBinder.bind([unit(1, 'hpea', 25000), unit(2, 'hpea', 25000)], hs);
+  assert.strictEqual(twins.get(1), '1/1000');
+  assert.strictEqual(twins.get(2), '2/1017');
+});
+
 console.log('[counter clock]');
 
 check('the fit is monotone and interpolates', () => {
-- 
