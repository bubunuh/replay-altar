+  // A building first met as a plain Unit (registered from a selection before
+  // WC3V saw it built, e.g. an Ancient of War built while unselected) has the
+  // building flag but none of the Building methods, so training from it threw
+  // "queueUnit is not a function" and stopped the simulation. Give it the
+  // Building behaviour, as a completed building, the first time it acts as one.
+  static adopt (unit) {
+    if (!unit || !unit.isBuilding || unit instanceof Building) return unit;
+    Object.setPrototypeOf(unit, Building.prototype);
+    unit.buildEvent = unit.buildEvent || null;
+    unit.buildState = BuildingStates.completed;
+    unit.buildProgress = 100;
+    unit.constructionEvent = unit.constructionEvent || null;
+    unit.constructionComplete = true;
+    unit.constructionStartTime = unit.constructionStartTime || null;
+    unit.constructionEndTime = unit.constructionEndTime || null;
+    unit.builderUnit = unit.builderUnit || null;
+    unit.builderWorkers = unit.builderWorkers || [];
+    unit.itemStock = unit.itemStock || {};
+    unit.shopItemsSet = unit.shopItemsSet || {};
+    unit.shopItemCooldowns = unit.shopItemCooldowns || {};
+    return unit;
+  }
+
   static isTavern (fixedItemId) {
