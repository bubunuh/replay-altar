# Builds a self-contained Linux casc-extract (casc-extract.cpp), statically linked, against the
# same CascLib commit as the other images, for the AppImage (scripts/casc/build-linux.sh). Like the
# Windows build, CascLib is patched to open every file read-only, so the AppImage can read the game
# folder directly, without podman's throwaway overlay.
FROM quay.io/fedora/fedora:latest
RUN dnf install -y --setopt=install_weak_deps=False git cmake make gcc-c++ glibc-static libstdc++-static zlib-static && dnf clean all
ARG CASCLIB_COMMIT=2a280f5a231966dc5d1b534978dd9f9f04a374cd
RUN git init -q /src/CascLib && cd /src/CascLib \
 && git fetch -q --depth 1 https://github.com/ladislav-zezula/CascLib.git ${CASCLIB_COMMIT} \
 && git checkout -q FETCH_HEAD \
 && sed -i '/^static bool BaseFile_Open(TFileStream \* pStream, LPCTSTR szFileName, DWORD dwStreamFlags)$/{n;s/^{$/{\n    dwStreamFlags |= STREAM_FLAG_READ_ONLY; \/\/ Replay Altar: never write to the game files/}' src/common/FileStream.cpp \
 && grep -q 'Replay Altar: never write' src/common/FileStream.cpp \
 && cmake -S /src/CascLib -B /src/CascLib/build -DCMAKE_BUILD_TYPE=Release \
      -DCASC_BUILD_SHARED_LIB=OFF -DCASC_BUILD_STATIC_LIB=ON -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -Wno-dev \
 && cmake --build /src/CascLib/build -j"$(nproc)"
COPY casc-extract.cpp /src/casc-extract.cpp
RUN g++ -O2 -std=c++17 -static -o /casc-extract /src/casc-extract.cpp \
      -I/src/CascLib/src $(find /src/CascLib/build -name 'libcasc*.a' | head -1) -lz -pthread \
 && strip /casc-extract
