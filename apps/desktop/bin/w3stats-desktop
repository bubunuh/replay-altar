#!/bin/sh
# Starts the W3Stats window. Flags: --background (show without focus), --game=<game key>
APP_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
ROOT="$(cd "$APP_DIR/../.." && pwd)"
# KDE matches the window to w3stats.desktop (taskbar icon) through this.
export CHROME_DESKTOP=w3stats.desktop
exec "$ROOT/node_modules/electron/dist/electron" --ozone-platform-hint=auto "$APP_DIR" "$@"
